<brls:Box
    width="auto"
    height="auto">

    <brls:ScrollingFrame
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0" >
        
        <brls:Box
            width="10000"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/brls/tab_details/padding_top"
            paddingRight="@style/brls/tab_details/padding_right"
            paddingBottom="@style/brls/tab_details/padding_bottom"
            paddingLeft="@style/brls/tab_details/padding_left">
            
            <brls:Header
                title="@i18n/settings/quality"/>
                
            <brls:SelectorCell
                id="fps"/>
                    
            <brls:SelectorCell
                id="resolution"/>

            <brls:SelectorCell
                id="resolution_scale"/>
                
            <brls:SelectorCell
                id="codec"/>

            <brls:BooleanCell
                id="request_hdr"/>
                
            <brls:SelectorCell
                id="decoder"/>

            <brls:BooleanCell
                id="use_hw_decoding"/>

            <brls:Header
                id="header"
                title="@i18n/settings/video_bitrate"
                subtitle="10.0 Mbps"
                paddingTop="60"/>
                
            <brls:Slider
                id="slider"
                width="auto"
                height="84"
                grow="1"/>

            <brls:Header
                id="image_adjustments_header"
                title="@i18n/settings/image_adjustments"
                paddingTop="60"
                lineTop="1px"/>

            <BooleanSliderCell
                id="dithering"/>

            <brls:BooleanCell
                id="upscaling"/>

            <brls:SelectorCell
                id="upscaling_mode"/>

            <BooleanSliderCell
                id="rcas"/>
            
            <brls:Header
                title="@i18n/settings/stream_settings"
                paddingTop="60"/>

            <brls:SelectorCell
                id="audio_backend"/>

            <brls:BooleanCell
                id="optimal"/>
            
            <brls:BooleanCell
                id="pcAudio"/>
                
            <brls:BooleanCell
                id="volume_amplification"/>

            <brls:BooleanCell
                id="low_latency_audio"/>

            <brls:Header
                title="@i18n/settings/latency_title"
                paddingTop="60"/>

            <brls:BooleanCell
                id="lowest_latency_pacing"/>

            <brls:BooleanCell
                id="fast_controller_polling"/>

            <brls:BooleanCell
                id="end_stream_on_home"/>

            <brls:Header
                title="@i18n/settings/keys"
                paddingTop="60"/>
                
            <brls:BooleanCell
                id="swap_ui"/>
                
            <brls:DetailCell
                id="swap_game"/>

            <brls:Header
                    title="@i18n/settings/deadzone/title"
                    paddingTop="60"/>

            <brls:DetailCell
                    id="dead_zone_stick_left"/>

            <brls:DetailCell
                    id="dead_zone_stick_right"/>

            <brls:DetailCell
                    id="anti_dead_zone_stick_left"/>

            <brls:DetailCell
                    id="anti_dead_zone_stick_right"/>

            <brls:Label text="@i18n/settings/deadzone/anti_note"
                width="auto" height="auto" fontSize="18" marginTop="8" marginBottom="12"/>

            <brls:Header
                title="@i18n/settings/stick/title"
                paddingTop="60"/>

            <brls:DetailCell
                    id="stick_curve_left"/>

            <brls:DetailCell
                    id="stick_curve_right"/>

            <brls:DetailCell
                    id="stick_outer_limit_left"/>

            <brls:DetailCell
                    id="stick_outer_limit_right"/>

            <brls:BooleanCell
                id="stick_tuning_joycon_only"/>

            <brls:Label text="@i18n/settings/stick/note"
                width="auto" height="auto" fontSize="18" marginTop="8" marginBottom="12"/>

            <brls:Header
                id="rumble_slider_header"
                title="@i18n/settings/rumble_force"
                subtitle="100%"
                paddingTop="60"/>
                
            <brls:Slider
                id="rumble_slider"
                width="auto"
                height="84"
                grow="1"/>

            <brls:Header
                title="@i18n/settings/gyro_title"
                paddingTop="60"
                lineTop="1px"/>

            <brls:BooleanCell id="gyro_enabled"/>
            <brls:SelectorCell id="joycon_gyro"/>
            <brls:BooleanCell id="joycon_pointer_mode"/>
            <brls:BooleanCell id="vhf_pro_compatibility"/>
            <brls:Label id="vhf_pro_hint" text="@i18n/settings/vhf_pro_compatibility_hint"
                width="auto" height="auto" fontSize="18" marginBottom="12"/>
            <brls:DetailCell id="gyro_source"/>
            <brls:SelectorCell id="gyro_gain"/>
            <brls:SelectorCell id="gyro_zero_drift"/>

            <brls:Header
                title="@i18n/settings/single_joycon"
                paddingTop="60"
                lineTop="1px"/>

            <brls:BooleanCell
                id="swap_stick_to_dpad"/>

            <brls:Header
                title="@i18n/settings/guide_key"
                paddingTop="60"/>
            
            <brls:DetailCell
                id="guide_key_buttons"/>
                
            <brls:SelectorCell
                id="guide_by_system_button"/>
                
            <brls:Header
                title="@i18n/settings/overlay"
                paddingTop="60"/>
                
            <brls:SelectorCell
                id="overlay_time"/>
            
            <brls:DetailCell
                id="overlay_buttons"/>
                
            <brls:SelectorCell
                id="overlay_by_system_button"/>
                
            <brls:Header
                title="@i18n/settings/mouse_input"
                paddingTop="60"/>
                
            <brls:SelectorCell
                id="mouse_input_time"/>
            
            <brls:DetailCell
                id="mouse_input_buttons"/>

            <brls:Header
                title="@i18n/settings/keyboard"
                paddingTop="60"/>

            <brls:SelectorCell
                id="keyboard_type"/>

            <brls:SelectorCell
                id="keyboard_fingers"/>
                
            <brls:Header
                title="@i18n/settings/mouse"
                paddingTop="60"/>

            <brls:BooleanCell
                id="touchscreen_mouse_mode"/>
                
            <brls:BooleanCell
                id="swap_mouse_keys"/>
                
            <brls:BooleanCell
                id="swap_mouse_scroll"/>
        
            <brls:Header
                id="mouse_speed_header"
                title="@i18n/settings/mouse_speed"
                subtitle="x1.0"
                paddingTop="60"/>
                
            <brls:Slider
                id="mouse_speed_slider"
                width="auto"
                height="84"
                grow="1"/>
                
            <brls:Header
                title="@i18n/settings/debug"
                paddingTop="60"
                lineTop="1px"/>
                
            <brls:BooleanCell
                id="writeLog"/>
            
        </brls:Box>

    </brls:ScrollingFrame>

</brls:Box>
